{
  "name": "ros2-assistant",
  "displayName": "ROS2 Assistant",
  "description": "ROS2 assistant extension for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ros2-assistant.setDomainId",
        "title": "ROS 2 Assistant: Set ROS_DOMAIN_ID"
      },
      {
        "command": "ros2-assistant.goBack",
        "title": "Go Back",
        "icon": "$(arrow-left)"
      },
      {
        "command": "ros2-assistant.openLaunchManager",
        "title": "ROS 2 Assistant: Open Launch Manager",
        "icon": "$(rocket)"
      },
      {
        "command": "ros2-assistant.openCommunicationDashboard",
        "title": "ROS 2 Assistant: Communication Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "ros2-assistant.openInterfaceExplorer",
        "title": "ROS 2 Assistant: Open Interface Explorer",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "ros2-assistant.bagToText",
        "title": "ROS 2 Assistant: Bag to text",
        "icon": "$(file-text)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ros2-assistant.goBack",
          "when": "view == ros2View",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ros2-sidebar",
          "title": "ROS2 Assistant",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "ros2-sidebar": [
        {
          "id": "ros2View",
          "name": "ROS2 Assistant",
          "icon": "$(list-tree)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^29.1.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
